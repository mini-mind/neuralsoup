{
  "name": "neuralsoup",
  "version": "1.0.0",
  "description": "基于PixiJS+React的具身智能体仿真 - 浮游生物SNN仿真",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:domain": "node --import tsx --test $(find tests/domain -name '*.test.ts' | sort)",
    "test:compat": "node --import tsx --test $(find tests/compat -name '*.test.ts' | sort)",
    "type-check": "tsc --noEmit",
    "check:pixi-imports": "node scripts/check-pixi-imports.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "keywords": [
    "pixi.js",
    "react",
    "snn",
    "embodied-ai",
    "simulation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "pixi.js-legacy": "^7.4.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.15.31",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.0.0",
    "tsx": "^4.20.6",
    "vite": "^5.0.0"
  }
}
